# Google Apps Script web app URL (required for template-based document generation)
# Deploy Code.gs as a web app and paste the URL here
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Template health checks use this document type for canary verification.
# The default is intentionally a regular document so the deep check creates
# one small Google Doc and verifies template links without needing table data.
TEMPLATE_HEALTH_DOCUMENT_TYPE=Baccalaureate-Certificate

# Google Cloud credentials JSON (for Cloud Vision OCR)
GOOGLE_CREDENTIALS_JSON=

# OpenAI API key
OPENAI_API_KEY=

# Optional: override default Google Docs template IDs (defaults are built into PDFGenerator.py)
# TemplateIDs_Baccalaureate_Certificate=
# TemplateIDs_Baccalaureate_Certificate_V2=
# TemplateIDs_Baccalaureate_School_Certificate=
